package udemy.allorden.java.jdbc.service;

import java.sql.Connection;
import java.sql.SQLException;
import java.util.List;

import udemy.allorden.java.jdbc.modelo.Categoria;
import udemy.allorden.java.jdbc.modelo.Producto;
import udemy.allorden.java.jdbc.repositorio.CategoriaRepositorioImpl;
import udemy.allorden.java.jdbc.repositorio.ProductoRepositorioImpl;
import udemy.allorden.java.jdbc.repositorio.Repositorio;
import udemy.allorden.java.jdbc.util.ConexionBD;

public class CatalogoServicio implements Service {
	private Repositorio<Producto> productoRepositorio;
	private Repositorio<Categoria> categoriaRepositorio;

	public CatalogoServicio() {
		super();
	}

	public CatalogoServicio(Repositorio<Producto> productoRepositorio, Repositorio<Categoria> categoriaRepositorio) {
		super();
		this.productoRepositorio = new ProductoRepositorioImpl();
		this.categoriaRepositorio = new CategoriaRepositorioImpl();
	}

	@Override
	public List<Producto> listar() throws SQLException {
		try (Connection connection = ConexionBD.getConnection()) {
			productoRepositorio.setConnection(connection);
			return productoRepositorio.listar();
		}
	}

	@Override
	public Producto porId(Long id) throws SQLException {
		try (Connection connection = ConexionBD.getConnection()) {
			productoRepositorio.setConnection(connection);
			return productoRepositorio.porId(id);
		}
		
	}

	@Override
	public Producto guardar(Producto producto) throws SQLException {
		try (Connection connection = ConexionBD.getConnection()) {
			productoRepositorio.setConnection(connection);
		}
		return null;
	}

	@Override
	public void eliminar(Long id) throws SQLException {
		try (Connection connection = ConexionBD.getConnection()) {
			productoRepositorio.setConnection(connection);
		}
	}

	@Override
	public List<Categoria> listarCategoria() throws SQLException {
		try (Connection connection = ConexionBD.getConnection()) {
			categoriaRepositorio.setConnection(connection);
		}
		return null;
	}

	@Override
	public Categoria porIdCategoria(Long id) throws SQLException {
		try (Connection connection = ConexionBD.getConnection()) {
			categoriaRepositorio.setConnection(connection);
		}
		return null;
	}

	@Override
	public Categoria guardarCategoria(Categoria categoria) throws SQLException {
		try (Connection connection = ConexionBD.getConnection()) {
			categoriaRepositorio.setConnection(connection);
		}
		return null;
	}

	@Override
	public void eliminarCategoria(Long id) throws SQLException {
		try (Connection connection = ConexionBD.getConnection()) {
			categoriaRepositorio.setConnection(connection);
		}
	}

	@Override
	public void guardarProductoConCategoria(Producto producto, Categoria categoria) throws SQLException {
		try (Connection connection = ConexionBD.getConnection()) {
			productoRepositorio.setConnection(connection);
			categoriaRepositorio.setConnection(connection);
		}
	}
}
