package udemy.allorden.java.swing;

import java.awt.Container;
import java.awt.FlowLayout;
import java.awt.HeadlessException;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

import javax.swing.JButton;
import javax.swing.JFrame;
import javax.swing.JTextField;

public class Window07CurrencyConverter extends JFrame implements ActionListener {

	private Container panel;
	private JButton buttonEUR, buttonUSD;
	private JTextField mount;
	
	public static final String CURRENCY_EUROS = "Euros";
	public static final String CURRENCY_DOLARES = "Dolares";
	
	public Window07CurrencyConverter() throws HeadlessException {
		super("Conversor de monedas");
		
		panel = getContentPane();
		panel.setLayout(new FlowLayout());
		
		buttonEUR = new JButton(CURRENCY_EUROS);
		buttonEUR.addActionListener(this);
		buttonUSD = new JButton(CURRENCY_DOLARES);
		
		panel.add(mount);
		panel.add(buttonEUR);
		panel.add(buttonUSD);
	}

	@Override
	public void actionPerformed(ActionEvent e) {
		// TODO Auto-generated method stub
		
	}
	
	public static void main(String[] args) {
		new Window07CurrencyConverter();
	}

}
